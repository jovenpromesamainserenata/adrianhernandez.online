<script>
  // La "x" vuelve a la página anterior si venimos de dentro de la web. Con la navegación sin
  // recarga (navegacion.js) el referrer no cambia, así que se mira también su marca en el historial.
  document.querySelector("[data-volver]").addEventListener("click", (e) => {
    const dentro = (history.state && history.state.dentro) || document.referrer.startsWith(location.origin);
    if (dentro && history.length > 1) {
      e.preventDefault();
      history.back();
    }
  });
</script>
