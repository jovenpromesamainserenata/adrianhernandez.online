---
layout: base.njk
permalink: /
claseBody: pagina-portada
sinAbout: true
scripts: [fuentes, captcha, sonido-portada]
# Fuentes del efecto de "Image". Solo se descargan las letras de la palabra (text=Image).
# Para cambiarlas: tocar esta lista y la de src/js/fuentes.js.
# Roboto se pide aparte (abajo) porque hace dos papeles: el efecto de "Image" y el texto del captcha.
fuentesGoogle: "family=Roboto+Mono&family=Archivo+Black&family=EB+Garamond&family=Saira&family=League+Script&family=Allerta&family=Carrois+Gothic&family=IBM+Plex+Sans+KR"
# Letras que hacen falta de Roboto: las de la marca del captcha y las de "Image".
fuenteCaptcha: "reCAPTCHA Privacy - Terms Image"
---
<script>
  // Si ya se ha pasado el captcha en esta visita, se quita antes de pintarlo:
  // así no da un parpadeo al volver a la portada.
  try {
    if (sessionStorage.getItem("captcha") === "hecho") document.documentElement.classList.add("captcha-visto");
  } catch {}
</script>
{% include "captcha.njk" %}
<main class="portada">
  <a class="mitad" href="/audio/" data-audio="/media/portada/audio.mp3"><span>Audio</span></a>
  <a class="mitad mitad-image" href="/image/"><span data-roll-fuentes>Image</span></a>
</main>
